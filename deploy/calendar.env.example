# Secret iCal URL from Google Calendar → Settings for my calendars →
# <your calendar> → Integrate calendar → "Secret address in iCal format".
# Treat this URL as a password — anyone with it can read your calendar events.
#
# Copy this file to calendar.env next to the binary and lock it down:
#   cp calendar.env.example calendar.env
#   chmod 600 calendar.env
ICAL_URL=https://calendar.google.com/calendar/ical/<id>/private-<token>/basic.ics
