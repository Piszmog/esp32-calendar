[Unit]
Description=E-paper calendar server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=server
WorkingDirectory=/home/server/calendar
EnvironmentFile=/home/server/calendar/calendar.env
ExecStart=/home/server/calendar/calendar-server \
  -listen :8080 \
  -tz America/Denver \
  -fetch-interval 10m
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Sandboxing. The server only reads its binary and serves HTTP, so it needs
# no writable paths and no capabilities. ProtectHome=read-only (not true)
# because the binary lives under /home/server/calendar.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
SystemCallArchitectures=native
# Keep @resources: the Go runtime raises RLIMIT_NOFILE at startup. EPERM
# (not SIGSYS) so any other filtered call fails instead of killing the process.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
